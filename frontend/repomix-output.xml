                  <div className="text-xs text-muted">
                    {h.date || h.creation_time ? fmtShort(h.date || h.creation_time) : ''}
                  </div>
                </div>
                {h.status != null && <Tag kind="current">{h.status}</Tag>}
              </div>
            ))}
          </div>
        )}
