        },
        yAxis: {
          type: 'value',
          min: minV,
          max: 100,
          interval: 10,
          splitLine: { lineStyle: { color: p.border } },
          axisLabel: { color: p.muted, formatter: '{value}%' },
        },
        series: [
          {
            name: 'attendance',
            type: 'line',
            data,
            smooth: false,
            symbol: 'circle',
            symbolSize: 8,
            lineStyle: { width: 3, color: p.success },
            itemStyle: { color: p.success },
            label: { show: true, position: 'top', color: p.muted, fontSize: 10, formatter: ({ value }) => (value != null ? `${value}%` : '') },
            areaStyle: {
              color: {
                type: 'linear', x: 0, y: 0, x2: 0, y2: 1,
                colorStops: [
                  { offset: 0, color: p.success + '44' },
                  { offset: 1, color: p.success + '00' },
                ],
              },
            },
            markLine: avg != null
              ? {
                  silent: true,
                  symbol: 'none',
