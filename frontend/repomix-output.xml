  const avg = values.length ? values.reduce((s, v) => s + v, 0) / values.length : null
  const minV = values.length ? Math.max(0, Math.floor((Math.min(...values) - 5) / 5) * 5) : 0
  return (
    <Chart
      height={280}
      option={{
        xAxis: {
          type: 'category',
          data: data.map((d) => d.label),
          boundaryGap: false,
          axisLine: { lineStyle: { color: p.border } },
