<file path="src/pages/DocumentsPage.jsx">
import React, { useMemo } from 'react'
import { useQuery } from '@tanstack/react-query'
import { FileText, Paperclip, ExternalLink } from 'lucide-react'
import { apiProfileFields, apiDocuments } from '../api/endpoints'
import { useAuth } from '../auth/AuthContext'
import { useI18n } from '../i18n/I18nContext'
import { Card, Spinner, ErrorBox, Empty, Tag } from '../components/ui'

export default function DocumentsPage() {
  const { t, fmtShort } = useI18n()
  const { user } = useAuth()
  const studentId = user?.student_id

  const fields = useQuery({
    queryKey: ['doc-fields', studentId],
    queryFn: () => apiProfileFields(studentId),
    enabled: studentId != null,
    staleTime: 10 * 60 * 1000,
  })

  const docs = useQuery({
    queryKey: ['documents', studentId],
    queryFn: () => apiDocuments(studentId),
    enabled: studentId != null,
    staleTime: 10 * 60 * 1000,
  })

  // Значения полей из /documents/get: [{ field_id / id, textValue, files... }]
  const valuesById = useMemo(() => {
    const map = {}
    const push = (arr) => {
      for (const v of Array.isArray(arr) ? arr : []) {
        const id = v.field_id ?? v.id ?? v.fieldId
        if (id != null) map[String(id)] = v
      }
    }
    push(docs.data)
    return map
  }, [docs.data])

  // Группируем поля по document_group_id, сохраняя порядок
  const groups = useMemo(() => {
    const list = Array.isArray(fields.data) ? fields.data : []
    const order = []
    const map = {}
    for (const f of list) {
      const key = f.document_group_id || 'other'
      if (!map[key]) {
        map[key] = []
        order.push(key)
      }
      map[key].push(f)
    }
    return order.map((key) => ({
      id: key,
      name: map[key][0]?.group_name || (key !== 'other' ? `${t('docGroup')} №${key}` : t('docTitle')),
      fields: map[key],
    }))
  }, [fields.data, t])

  const renderValue = (f) => {
    const v = valuesById[String(f.id)]
    const text = v?.textValue ?? f.textValue
    const files = v?.files ?? f.files
    if (Array.isArray(files) && files.length > 0) {
      return (
        <div className="flex flex-col gap-1 items-end">
          {files.map((file, i) => {
            const url = typeof file === 'string' ? file : file?.url || file?.file_path
            const name = typeof file === 'string' ? t('docFile') : file?.name || file?.filename || t('docFile')
            return url ? (
              <a key={i} href={url} target="_blank" rel="noreferrer" className="text-xs inline-flex items-center gap-1">
                <Paperclip size={12} />
                {name}
              </a>
            ) : (
              <span key={i} className="text-xs text-muted inline-flex items-center gap-1">
                <Paperclip size={12} /> {name}
              </span>
            )
          })}
        </div>
      )
    }
    if (text != null && text !== '') {
      if (f.type === 'date') {
        const d = new Date(String(text).slice(0, 10) + 'T12:00:00')
        return <span className="text-sm">{Number.isNaN(d.getTime()) ? text : fmtShort(text)}</span>
      }
      return <span className="text-sm text-right">{String(text)}</span>
    }
    return <span className="text-sm text-muted italic">{t('docNoValue')}</span>
  }

  if (studentId == null) {
    return (
      <main className="page">
        <h1 className="page__title">{t('docTitle')}</h1>
        <Card><Empty text={t('docEmpty')} icon={FileText} /></Card>
      </main>
    )
  }

  return (
    <main className="page">
      <h1 className="page__title">{t('docTitle')}</h1>
      <p className="page__subtitle">{t('docSubtitle')}</p>

      {fields.isLoading || docs.isLoading ? (
        <Spinner />
      ) : fields.isError ? (
        <Card><ErrorBox onRetry={() => fields.refetch()} /></Card>
      ) : groups.length === 0 ? (
        <Card><Empty text={t('docEmpty')} icon={FileText} /></Card>
      ) : (
        <div className="flex flex-col gap-4">
          {groups.map((g) => (
            <Card key={g.id} title={g.name} icon={<FileText size={17} />}>
              <div className="overflow-x-auto">
                <table className="marks-table">
                  <tbody>
                    {g.fields.map((f) => (
                      <tr key={f.id}>
                        <td className="text-sm" style={{ width: '45%' }}>
                          <div className="flex items-center gap-2">
                            <span>{f.name}</span>
                            {f.type === 'file' && <Tag kind="lab">{t('docFile')}</Tag>}
                          </div>
                        </td>
                        <td className="text-right">{renderValue(f)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </Card>
          ))}
          <p className="text-xs text-muted -mt-2">
            {t('docSubtitle')}. <ExternalLink size={11} className="inline" /> — {t('open')}
          </p>
        </div>
      )}
    </main>
  )
}
</file>

<file path="src/pages/GradesPage.jsx">
import React, { useMemo, useState } from 'react'
import { useQuery } from '@tanstack/react-query'
import { BarChart3, ListChecks, GraduationCap, CalendarCheck } from 'lucide-react'
import { apiStudentVisits, apiStudentExams, apiAcademicPerformance } from '../api/endpoints'
import { MARK_FIELDS } from '../api/constants'
import { useI18n } from '../i18n/I18nContext'
import { Card, Spinner, ErrorBox, Empty, Chip, MarkPill } from '../components/ui'
import { SubjectAverageChart, MarksDistributionChart } from '../components/charts'
import { normalize } from '../utils/format'

export default function GradesPage() {
  const { t, fmtShort } = useI18n()
  const [subject, setSubject] = useState('all')
  const [visible, setVisible] = useState(25)

  const visits = useQuery({ queryKey: ['student-visits'], queryFn: apiStudentVisits, staleTime: 5 * 60 * 1000 })
  const exams = useQuery({ queryKey: ['student-exams'], queryFn: apiStudentExams, staleTime: 10 * 60 * 1000 })
  const perf = useQuery({ queryKey: ['academic-performance'], queryFn: apiAcademicPerformance })

  const marked = useMemo(
    () => (visits.data || []).filter((v) => MARK_FIELDS.some((f) => v[f.key] != null)),
    [visits.data]
  )

  const subjects = useMemo(() => {
    const set = new Set(marked.map((v) => v.spec_name).filter(Boolean))
    return [...set].sort((a, b) => a.localeCompare(b))
  }, [marked])

  const filtered = useMemo(
    () => (subject === 'all' ? marked : marked.filter((v) => v.spec_name === subject)),
    [marked, subject]
  )

  const subjectAverages = useMemo(() => {
    const acc = {}
    for (const v of filtered) {
      for (const f of MARK_FIELDS) {
        const m = v[f.key]
        if (m == null) continue
        ;(acc[v.spec_name] ||= { sum: 0, n: 0 })
        acc[v.spec_name].sum += Number(m)
        acc[v.spec_name].n += 1
      }
    }
    return Object.entries(acc)
      .map(([label, { sum, n }]) => ({ label, value: Number((sum / n).toFixed(2)) }))
      .sort((a, b) => b.value - a.value)
  }, [filtered])

  const distribution = useMemo(() => {
    const counts = { 5: 0, 4: 0, 3: 0, 2: 0, 1: 0 }
    for (const v of filtered) {
      for (const f of MARK_FIELDS) {
        const raw = v[f.key]
        if (raw == null || raw === '') continue
        const m = Number(raw)
        if (Number.isNaN(m)) continue
        const key = Math.min(Math.max(Math.round(m), 1), 5)
        counts[key] += 1
      }
    }
    return [5, 4, 3, 2, 1].map((label) => ({ label, value: counts[label] }))
  }, [filtered])

  const attendance = useMemo(() => {
    let present = 0
    let absent = 0
    let late = 0
    for (const v of visits.data || []) {
      if (v.status_was === 1) present += 1
      else if (v.status_was === 0) absent += 1
      else if (v.status_was === 2) late += 1
    }
    const total = present + absent + late
    return { present, absent, late, total, percent: total ? Math.round((present / total) * 100) : null }
  }, [visits.data])

  const recent = useMemo(
    () =>
      filtered
        .slice()
        .sort((a, b) => String(b.date_visit).localeCompare(String(a.date_visit)))
        .slice(0, visible),
    [filtered, visible]
  )

  if (visits.isLoading) {
    return (
      <main className="page">
        <h1 className="page__title">{t('gradesTitle')}</h1>
        <Spinner />
      </main>
    )
  }

  return (
    <main className="page">
      <h1 className="page__title">{t('gradesTitle')}</h1>
      <p className="page__subtitle">
        {visits.data?.length && attendance.percent != null
          ? `${t('gradesVisited')}: ${attendance.percent}% (${attendance.present}/${attendance.total})`
          : ''}
      </p>

      {visits.isError ? (
        <Card><ErrorBox onRetry={() => visits.refetch()} /></Card>
      ) : (
        <>
          <div className="grid-2 mb-4">
            <Card title={t('gradesAvgSubject')} icon={<BarChart3 size={17} />}>
              {subjectAverages.length ? (
                <SubjectAverageChart data={subjectAverages} />
              ) : (
                <Empty text={t('gradesNoMarks')} />
              )}
            </Card>
            <Card title={t('gradesDistributionFull')} icon={<BarChart3 size={17} />}>
              {subjectAverages.length ? (
                <MarksDistributionChart data={distribution} />
              ) : (
                <Empty text={t('gradesNoMarks')} />
              )}
            </Card>
          </div>

          {perf.data?.progress && (
            <Card title={t('gradesByCategory')} icon={<ListChecks size={17} />} className="mb-4">
              <div className="flex flex-wrap gap-2">
                {Object.entries(perf.data.progress).map(([k, v]) => (
                  <span key={k} className={`chip !cursor-default ${k === 'total' ? 'is-active' : ''}`}>
                    {t(`marks.${k}`)}: <b className="ml-1">{v}</b>
                  </span>
                ))}
              </div>
            </Card>
          )}

          {subjects.length > 0 && (
            <div className="flex flex-wrap items-center gap-2 mb-3">
              <Chip active={subject === 'all'} onClick={() => setSubject('all')}>{t('all')}</Chip>
              {subjects.map((s) => (
                <Chip key={s} active={subject === s} onClick={() => setSubject(s)}>{s}</Chip>
              ))}
            </div>
          )}

          <Card title={t('gradesRecent')} icon={<ListChecks size={17} />} className="mb-4">
            {recent.length === 0 ? (
              <Empty text={t('gradesNoMarks')} />
            ) : (
              <div className="overflow-x-auto">
                <table className="marks-table">
                  <thead>
                    <tr>
                      <th>{t('gradesDate')}</th>
                      <th>{t('gradesSubject')}</th>
                      <th>{t('gradesTheme')}</th>
                      <th>{t('gradesMarks')}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {recent.map((v, i) => (
                      <tr key={i}>
                        <td className="whitespace-nowrap text-muted text-xs">{fmtShort(v.date_visit)}</td>
                        <td className="text-sm">{v.spec_name}</td>
                        <td className="text-xs text-muted">{v.lesson_theme}</td>
                        <td>
                          <div className="flex flex-wrap gap-1">
                            {MARK_FIELDS.filter((f) => v[f.key] != null).map((f) => (
                              <span key={f.key} className="inline-flex items-center gap-1 mr-1" title={t(f.label)}>
                                <MarkPill mark={v[f.key]} />
                              </span>
                            ))}
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {filtered.length > visible && (
              <div className="flex justify-center mt-3">
                <button className="btn btn--ghost !py-2 text-sm" onClick={() => setVisible((v) => v + 50)}>
                  +50
                </button>
              </div>
            )}
          </Card>
        </>
      )}

      <Card title={t('gradesExams')} icon={<GraduationCap size={17} />} className="mb-4">
        {exams.isLoading ? (
          <Spinner />
        ) : exams.isError ? (
          <ErrorBox onRetry={() => exams.refetch()} />
        ) : !exams.data?.length ? (
          <Empty text={t('gradesNoExams')} icon={GraduationCap} />
        ) : (
          <div className="overflow-x-auto">
            <table className="marks-table">
              <thead>
                <tr>
                  <th>{t('gradesDate')}</th>
                  <th>{t('gradesExamSubject')}</th>
                  <th>{t('gradesExamTeacher')}</th>
                  <th>{t('gradesExamMark')}</th>
                </tr>
              </thead>
              <tbody>
                {exams.data
                  .slice()
                  .sort((a, b) => String(b.date).localeCompare(String(a.date)))
                  .map((e, i) => (
                    <tr key={i}>
                      <td className="whitespace-nowrap text-muted text-xs">{fmtShort(e.date)}</td>
                      <td className="text-sm">{e.spec}</td>
                      <td className="text-xs text-muted">{e.teacher}</td>
                      <td><MarkPill mark={e.mark} /></td>
                    </tr>
                  ))}
              </tbody>
            </table>
          </div>
        )}
      </Card>

      <Card title={t('gradesAttendance')} icon={<CalendarCheck size={17} />}>
        {!visits.data?.length ? (
          <Empty text={t('noData')} icon={CalendarCheck} />
        ) : (
          <div className="flex flex-wrap gap-2">
            <span className="chip !cursor-default" style={{ color: 'var(--success)' }}>
              {t('gradesPresent')}: <b className="ml-1">{attendance.present}</b>
            </span>
            <span className="chip !cursor-default" style={{ color: 'var(--danger)' }}>
              {t('gradesAbsent')}: <b className="ml-1">{attendance.absent}</b>
            </span>
            {attendance.late > 0 && (
              <span className="chip !cursor-default" style={{ color: 'var(--warning)' }}>
                {t('gradesLate')}: <b className="ml-1">{attendance.late}</b>
              </span>
            )}
          </div>
        )}
      </Card>
    </main>
  )
}
